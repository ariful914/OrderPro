<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardReportHeaderFilter"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_margin_bottom"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="@dimen/card_corner_radius_expressive"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/filterHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_filter"
                app:tint="@color/google_blue" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/report_filters_title"
                android:textColor="@color/on_surface_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/filterExpandIcon"
                android:layout_width="35dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_report_spinner_badge"
                android:contentDescription="@null"
                android:padding="5dp"
                android:src="@drawable/ic_spinner_chevron"
                app:tint="@color/google_blue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/filterContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/fromLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:hint="@string/report_filter_from"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFromDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:minHeight="42dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/toLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:hint="@string/report_filter_to"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etToDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:minHeight="42dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchReport"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:minWidth="84dp"
                android:text="@string/report_filter_search"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_search"
                app:iconGravity="textStart"
                app:iconPadding="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/regionAreaRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/regionFilterContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:hint="@string/report_filter_region">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_spinner"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <Spinner
                        android:id="@+id/spinnerRegion"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="0dp"
                        android:paddingEnd="34dp"
                        android:spinnerMode="dropdown" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/bg_report_spinner_badge"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:src="@drawable/ic_spinner_chevron"
                        app:tint="@color/google_blue" />
                </FrameLayout>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/areaFilterContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:hint="@string/report_filter_area">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_spinner"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <Spinner
                        android:id="@+id/spinnerArea"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="0dp"
                        android:paddingEnd="34dp"
                        android:spinnerMode="dropdown" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/bg_report_spinner_badge"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:src="@drawable/ic_spinner_chevron"
                        app:tint="@color/google_blue" />
                </FrameLayout>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/subAreaFilterContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:hint="@string/report_filter_sub_area">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_spinner"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <Spinner
                        android:id="@+id/spinnerSubArea"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="0dp"
                        android:paddingEnd="34dp"
                        android:spinnerMode="dropdown" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/bg_report_spinner_badge"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:src="@drawable/ic_spinner_chevron"
                        app:tint="@color/google_blue" />
                </FrameLayout>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/territoryFilterContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:hint="@string/report_filter_territory">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_spinner"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <Spinner
                        android:id="@+id/spinnerTerritory"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="0dp"
                        android:paddingEnd="34dp"
                        android:spinnerMode="dropdown" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/bg_report_spinner_badge"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:src="@drawable/ic_spinner_chevron"
                        app:tint="@color/google_blue" />
                </FrameLayout>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

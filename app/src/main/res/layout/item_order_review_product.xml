<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvReviewProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="@color/on_surface_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReviewUnitPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_variant_light"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReviewLineTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/google_blue"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnReviewDecrease"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@color/tonal_surface_light"
                android:contentDescription="Decrease quantity"
                android:focusable="true"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/google_blue"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReviewProductQuantity"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@color/tonal_surface_light"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/on_surface_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnReviewIncrease"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@color/tonal_surface_light"
                android:contentDescription="Increase quantity"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/google_blue"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnReviewRemove"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:contentDescription="Remove item from order"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:text="Remove"
                android:textColor="@color/trend_negative_red"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

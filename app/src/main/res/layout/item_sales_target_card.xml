<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="@dimen/card_corner_radius_expressive"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Target ID, Month & Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tvTargetStatusBadge"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTargetId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TGT-202611-102"
                    android:textColor="@color/google_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTargetMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="November 2026"
                    android:textColor="@color/on_surface_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTargetStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/shape_rounded_badge"
                android:backgroundTint="@color/status_pending_amber_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Pending"
                android:textColor="@color/status_pending_amber"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Submitter & Territory Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_orderpro_logo"
                app:tint="@color/on_surface_variant_light" />

            <TextView
                android:id="@+id/tvEmployeeDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Kamrul Hasan · Territory Officer"
                android:textColor="@color/on_surface_variant_light"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSubmissionDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01/11/2026"
                android:textColor="@color/on_surface_variant_light"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Metric Highlight Tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Total Units Tile -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/shape_rounded_badge"
                android:backgroundTint="@color/tonal_surface_light"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARGET UNITS"
                    android:textColor="@color/on_surface_variant_light"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalUnits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="485 units"
                    android:textColor="@color/on_surface_light"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Total Value Tile -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1.2"
                android:background="@drawable/shape_rounded_badge"
                android:backgroundTint="@color/google_blue_container"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARGET VALUE"
                    android:textColor="@color/on_google_blue_container"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="৳684,200.00"
                    android:textColor="@color/google_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Senior Edited Note indicator (if adjusted by senior) -->
        <TextView
            android:id="@+id/tvSeniorEditedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/shape_rounded_badge"
            android:backgroundTint="@color/tonal_surface_light"
            android:drawableStart="@drawable/ic_check"
            android:drawablePadding="4dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Senior Adjusted Target"
            android:textColor="@color/google_blue"
            android:textSize="11sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/outline_light" />

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewDetails"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Details"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/outline_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReviewEdit"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Review &amp; Edit"
                android:textSize="12sp"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

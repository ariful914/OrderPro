<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/reportsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_light"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/order_reports"
        app:titleTextColor="@color/on_surface_light" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/reportsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/order_reports_intro"
                android:textColor="@color/on_surface_variant_light"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/order_report_activity"
                android:textColor="@color/on_surface_light"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/shape_rounded_badge"
                android:backgroundTint="@color/google_blue_container"
                android:padding="12dp"
                android:text="@string/demo_data_notice"
                android:textColor="@color/on_google_blue_container"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/reportDailyInvoice"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="@dimen/card_corner_radius_expressive"
                app:cardElevation="0dp"
                app:rippleColor="@color/google_blue_container"
                app:strokeColor="@color/outline_light"
                app:strokeWidth="1dp">

                <include layout="@layout/item_order_report_card"
                    android:tag="@string/daily_invoice" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/order_report_performance"
                android:textColor="@color/on_surface_light"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/reportActualSales"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="@dimen/card_corner_radius_expressive"
                app:cardElevation="0dp"
                app:rippleColor="@color/google_blue_container"
                app:strokeColor="@color/outline_light"
                app:strokeWidth="1dp">

                <include layout="@layout/item_order_report_card"
                    android:tag="@string/actual_sales" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/reportCustomerSales"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="@dimen/card_corner_radius_expressive"
                app:cardElevation="0dp"
                app:rippleColor="@color/google_blue_container"
                app:strokeColor="@color/outline_light"
                app:strokeWidth="1dp">

                <include layout="@layout/item_order_report_card"
                    android:tag="@string/customer_sales" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/reportProductSales"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="@dimen/card_corner_radius_expressive"
                app:cardElevation="0dp"
                app:rippleColor="@color/google_blue_container"
                app:strokeColor="@color/outline_light"
                app:strokeWidth="1dp">

                <include layout="@layout/item_order_report_card"
                    android:tag="@string/product_sales" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/reportComparison"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="@dimen/card_corner_radius_expressive"
                app:cardElevation="0dp"
                app:rippleColor="@color/google_blue_container"
                app:strokeColor="@color/outline_light"
                app:strokeWidth="1dp">

                <include layout="@layout/item_order_report_card"
                    android:tag="@string/sales_comparison" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/order_report_targets"
                android:textColor="@color/on_surface_light"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/reportSalesTarget"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="@dimen/card_corner_radius_expressive"
                app:cardElevation="0dp"
                app:rippleColor="@color/google_blue_container"
                app:strokeColor="@color/outline_light"
                app:strokeWidth="1dp">

                <include layout="@layout/item_order_report_card"
                    android:tag="@string/target_status_report" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

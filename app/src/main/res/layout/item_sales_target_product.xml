<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="@dimen/card_corner_radius_expressive"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Badges & SKU Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBrandBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_rounded_badge"
                android:backgroundTint="@color/google_blue"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Brand"
                android:textColor="@color/surface_light"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProductSku"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="SKU: 371077"
                android:textColor="@color/on_surface_variant_light"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPackSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_rounded_badge"
                android:backgroundTint="@color/tonal_surface_light"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="100 ml"
                android:textColor="@color/on_surface_variant_light"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Product Name -->
        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Avene Xeracalm Cleansing Gel"
            android:textColor="@color/on_surface_light"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Price & Baseline Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProductPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TP: ৳1,900.00  |  MRP: ৳2,185.00"
                android:textColor="@color/google_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPreviousQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last month: 30"
                android:textColor="@color/on_surface_variant_light"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/outline_light" />

        <!-- Editable Quantity Stepper Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target Qty:"
                android:textColor="@color/on_surface_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Quantity Stepper Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/shape_rounded_badge"
                android:backgroundTint="@color/tonal_surface_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/btnQtyDecrease"
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Decrease target quantity"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/google_blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTargetQty"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="5"
                    android:selectAllOnFocus="true"
                    android:text="0"
                    android:textColor="@color/google_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnQtyIncrease"
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Increase target quantity"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/google_blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvItemSubtotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="৳0.00"
                android:textColor="@color/trend_positive_green"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
